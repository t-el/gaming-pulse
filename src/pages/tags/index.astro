---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getReports, reportsByTag } from '../../lib/reports';
import { href, tagSlug } from '../../lib/paths';

const tags = [...reportsByTag(await getReports()).entries()];
const description = 'Topics covered across Gaming Pulse briefings.';
---

<BaseLayout title="Tags" description={description}>
  <p class="kicker">Topics</p>
  <h1>Tags</h1>
  <p class="lede">{description}</p>
  {
    tags.length > 0 ? (
      <ul class="tag-cloud">
        {tags.map(([tag, reports]) => (
          <li>
            <a href={href(`/tags/${tagSlug(tag)}/`)}>
              <span>{tag}</span>
              <span class="count">
                {reports.length} {reports.length === 1 ? 'briefing' : 'briefings'}
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty">Tags appear here once a briefing lists them in frontmatter.</p>
    )
  }
</BaseLayout>
